# Application
NODE_ENV=development
PORT=3000

# Database (SQLite - file based, no installation needed)
DATABASE_URL="file:./dev.db"

# JWT Secrets (use random 64-char hex strings)
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_here_different_from_above

# JWT Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
